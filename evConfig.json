{
  "reporterOptions": {
    "reportFormat": "json",
    "fileName": "aggregatedReportForRun.json",
    "outputDir": "./evincedReports",
    "tmpDir": "./evincedReports/tmp"
  },
  "uploadToPlatformOptions": {
    "enableUploadToPlatform": true,
    "setUploadToPlatformDefault": false
  },
  "logging": {
    "LOGGING_LEVEL": "info",
    "ADD_LOGGING_CONTEXT": true
  },
  "sdkLogging": {
    "enable": true,
    "level": "debug",
    "directory": "./logs",
    "browserLoggingEnabled": true,
    "systemInformationLoggingEnabled": true,
    "maxLogLength": 100000
  },
  "skipValidations": [
    {
      "selector": "*",
      "urlRegex": ".*demo.evinced.com\/",
      "validationTypes": [
        "NOT_FOCUSABLE"
      ]
    }
  ]
}